# ---------------------------------------------------------------------------
# Solana Copy Trader - environment template
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Core infra ---
# In Docker Compose these hostnames resolve to the postgres/redis services.
DATABASE_URL=postgresql://sct:sct_password@postgres:5432/sct?schema=public
REDIS_URL=redis://redis:6379

# For running services on the host (outside Docker) against the compose infra:
# DATABASE_URL=postgresql://sct:sct_password@localhost:5432/sct?schema=public
# REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_32_random_bytes_hex
JWT_EXPIRES_IN=7d

# --- Solana / RPC ---
# Get a free key at https://helius.dev
HELIUS_API_KEY=your_helius_api_key
# Cluster RPC. For local dev point at the bundled validator.
SOLANA_RPC_URL=http://solana-validator:8899
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# --- Vault program ---
# Deployed Anchor program id (filled in after `anchor deploy`).
VAULT_PROGRAM_ID=VauLt1111111111111111111111111111111111111
# Executor signer. In production load from KMS/secret manager, NEVER commit.
# Path to a JSON keypair file OR a base58 secret key.
EXECUTOR_AUTHORITY_KEY=/run/secrets/executor-keypair.json

# --- Jito ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_TOKEN=

# --- Notifications (all optional) ---
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.com

# --- App ---
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
PORT=3001

# --- Safety ---
# When true the execution service simulates trades instead of submitting on-chain.
# Strongly recommended for the first week.
PAPER_TRADING=true

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_SOLANA_RPC_URL=http://localhost:8899
NEXT_PUBLIC_VAULT_PROGRAM_ID=VauLt1111111111111111111111111111111111111
