{
  "name": "solana-copy-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial Solana copy trading platform with on-chain vault execution",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @sct/database generate",
    "db:migrate": "pnpm --filter @sct/database migrate:dev",
    "db:deploy": "pnpm --filter @sct/database migrate:deploy",
    "db:studio": "pnpm --filter @sct/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
